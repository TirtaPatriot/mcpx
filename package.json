{
  "name": "@ekoeryanto/mcpx",
  "version": "1.0.0",
  "description": "OAuth 2.1 gateway and web dashboard for MCP servers (HTTP and stdio), built on Bun and ElysiaJS",
  "license": "MIT",
  "author": "Eko Eryanto <ekoeryanto@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ekoeryanto/mcpx.git"
  },
  "homepage": "https://github.com/ekoeryanto/mcpx#readme",
  "bugs": "https://github.com/ekoeryanto/mcpx/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "oauth2",
    "gateway",
    "bun",
    "elysia"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "type": "module",
  "bin": {
    "mcpx": "src/cli.ts"
  },
  "files": [
    "src",
    "public",
    "web/dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "module": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --parallel dev:server dev:web",
    "dev:server": "bun run --watch src/index.ts",
    "dev:web": "bunx --bun vite --config web/vite.config.ts",
    "build": "bunx --bun vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "bun test",
    "check": "bun run typecheck && bun test && bun run test:web && bun run build",
    "test:web": "cd web && bun test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "elysia": "^1.4.30"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@happy-dom/global-registrator": "^21.0.3",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "axe-core": "^4.14.0",
    "bun-types": "latest",
    "happy-dom": "^21.0.3",
    "preact": "^11.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  }
}
