# Salin ke .env lalu isi. Buat secret acak: openssl rand -hex 32
CLIENT_ID=gemini-mcp
CLIENT_SECRET=ganti-dengan-secret-acak

# JSON sebaris, gunakan tanda kutip tunggal di luar.
# Server MCP yang butuh header auth: pakai bentuk objek {"url":..., "headers":{...}}
MCP_SERVERS='{"filesystem":"http://host.docker.internal:3001","github":{"url":"http://host.docker.internal:3002","headers":{"Authorization":"Bearer token-server-github"}}}'

# URL publik gateway (origin saja, tanpa path). Sangat disarankan: dipakai Gemini
# untuk menemukan endpoint OAuth lewat /.well-known/*
PUBLIC_URL=https://gateway.example.com

# Opsional
#PORT=3000
#ALLOWED_REDIRECT_HOSTS=google.com
#ACCESS_TOKEN_TTL=3600
#LOG_SSE_CHUNKS=true
