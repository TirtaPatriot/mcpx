# Password of the "admin" user for the dashboard (/admin).
# If empty, a random password is generated on first start and printed once in the log.
# ADMIN_PASSWORD=

# Gateway port (default: 3000)
PORT=3000

# SQLite database path (default: ./data/tokens.db)
DB_PATH=./data/tokens.db

# Public URL of the gateway (origin only, no path). Recommended for OAuth discovery by AI clients (Gemini, ChatGPT, etc.)
PUBLIC_URL=https://gateway.example.com

# ------------------------------------------------------------------------------
# OPTIONAL SEEDING (credentials and servers can also be added in the dashboard at /admin)
# ------------------------------------------------------------------------------
# CLIENT_ID=universal-ai
# CLIENT_SECRET=replace-with-a-random-secret-or-create-one-in-the-dashboard

# Inline JSON for the initial MCP servers:
# MCP_SERVERS='{"filesystem":"http://host.docker.internal:3001","github":{"url":"http://host.docker.internal:3002","headers":{"Authorization":"Bearer token-server-github"}}}'

# ALLOWED_REDIRECT_HOSTS=google.com,oauth-redirect.googleusercontent.com,chatgpt.com,openai.com,claude.ai,anthropic.com,cursor.com,localhost,127.0.0.1
# ACCESS_TOKEN_TTL=2592000 # Seconds; default 30 days (2592000s) so AI sessions do not drop often
# REFRESH_TOKEN_TTL=31536000 # Seconds; default 1 year
# REFRESH_GRACE_PERIOD=60 # Seconds; tolerance for refresh-token rotation, to avoid race conditions
# Extra host variables that MCP processes may inherit, comma-separated. MCP processes do not inherit the
# gateway environment otherwise. Prefer env_vars on the server for secrets.
# MCP_PASSTHROUGH_ENV=
# LOG_SSE_CHUNKS=true
