# Password untuk Dashboard Manajemen (/admin), user "admin".
# Jika kosong, password acak dibuat saat start pertama dan dicetak sekali di log.
# ADMIN_PASSWORD=

# Port gateway (default: 3000)
PORT=3000

# Path database SQLite (default: ./data/tokens.db)
DB_PATH=./data/tokens.db

# URL publik gateway (origin saja, tanpa path). Disarankan untuk discovery OAuth AI (Gemini, ChatGPT, dll.)
PUBLIC_URL=https://gateway.example.com

# ------------------------------------------------------------------------------
# OPSIONAL SEEDING (Kredensial dan server juga bisa ditambah langsung lewat Web UI di /admin)
# ------------------------------------------------------------------------------
# CLIENT_ID=universal-ai
# CLIENT_SECRET=ganti-dengan-secret-acak-atau-buat-di-ui

# JSON sebaris untuk server MCP awal:
# MCP_SERVERS='{"filesystem":"http://host.docker.internal:3001","github":{"url":"http://host.docker.internal:3002","headers":{"Authorization":"Bearer token-server-github"}}}'

# ALLOWED_REDIRECT_HOSTS=google.com,oauth-redirect.googleusercontent.com,chatgpt.com,openai.com,claude.ai,anthropic.com,cursor.com,localhost,127.0.0.1
# ACCESS_TOKEN_TTL=2592000 # Detik, default 30 hari (2592000s) agar sesi AI tidak sering terputus
# REFRESH_TOKEN_TTL=31536000 # Detik, default 1 tahun
# REFRESH_GRACE_PERIOD=60 # Detik, toleransi rotasi refresh token untuk mencegah race condition
# LOG_SSE_CHUNKS=true
